# ==============================================================================
# EAGLE EYE — AI SECURITY SYSTEM CONFIGURATION (.env)
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME="Eagle Eye - AI Security Platform"

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (GitHub Student Pack Ready)
# ------------------------------------------------------------------------------
# Option A: Local SQLite (Default - Zero setup required)
DATABASE_URL="sqlite:///data/eagle_eye.db"

# Option B: Hosted PostgreSQL via Supabase / Neon / DigitalOcean (GitHub Student Pack)
# DATABASE_URL="postgresql://postgres:your_password@db.xxxxxx.supabase.co:5432/postgres"
# DATABASE_URL="postgresql://user:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. MEDIA & ASSET STORAGE (Local vs. Cloud S3 / DigitalOcean Spaces)
# ------------------------------------------------------------------------------
# Option A: Local Filesystem Storage (Default)
STORAGE_BACKEND="local"

# Option B: DigitalOcean Spaces / AWS S3 (GitHub Student Pack Free Credits)
# STORAGE_BACKEND="s3"
# S3_ENDPOINT_URL="https://nyc3.digitaloceanspaces.com"
# S3_BUCKET="eagle-eye-vault"
# S3_ACCESS_KEY="DO_SPACES_ACCESS_KEY"
# S3_SECRET_KEY="DO_SPACES_SECRET_KEY"
# S3_REGION="nyc3"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT & RBAC)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY="replace-with-a-random-secure-secret-key-32-chars-minimum"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 4. DEFAULT INITIAL CREDENTIALS (Seeded on first launch)
# ------------------------------------------------------------------------------
# Admin:  username: admin | password: adminPassword123!
# Guard:  username: guard | password: guardPassword123!
